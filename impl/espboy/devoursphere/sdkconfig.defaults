# Devour Sphere on the ESPboy (ESP8266 on a WeMos D1 mini, 4 MB flash).
# ESP8266_RTOS_SDK v3.4. See ../SPEC.md "メモリ配分" for what these buy.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# DIO at 40 MHz is what every WeMos D1 mini boots with; the code runs from
# this flash through a 16 KB cache, so 80 MHz would be worth a try on a
# board known to take it (CONFIG_ESPTOOLPY_FLASHFREQ_80M).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# 160 MHz: the simulation is the critical path and there is one core
CONFIG_ESP8266_DEFAULT_CPU_FREQ_160=y

# -Os. The 200 KB of code executes from flash through the cache, so the
# smaller it is the more of the hot loops stay resident. (The SDK's
# "release" level is -Os; "debug" is -Og.)
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y
CONFIG_OPTIMIZATION_LEVEL_RELEASE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_OPTIMIZATION_ASSERTIONS_SILENT=y

# 32 KB instruction cache, 32 KB IRAM. The SDK's own IRAM code is 20 KB
# and ShapoGFX's span loops (SHAPOGFX3D_HOT_ATTR in
# components/shapogfx/CMakeLists.txt) 4 KB, so the 32 KB still hold them;
# the 16 KB that the default (48 KB IRAM, 16 KB cache) would have left as
# a 32-bit-only heap nothing asks for goes to the cache instead. The first
# device reading (16 KB cache) had the mesh walk and the band rasterizing
# running 5-10x slower than the same code on the RP2040, which is what
# code executing from flash past the cache looks like. To compare, set
# this to n and delete sdkconfig before building (sdkconfig.defaults is
# only read when there is no sdkconfig).
CONFIG_SOC_FULL_ICACHE=y

# The one task: it builds the scene and rasterizes the bands, and
# buildSphere() recurses. FreeRTOS takes this from the heap at start-up.
# Keep ds_config.hpp's STACK_BYTES in step.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The boot log (memory figures, see app_main.cpp) on the USB serial
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The task watchdog stays: the game task feeds it once a frame. The idle
# task, which would otherwise feed it, never runs -- the frame loop never
# blocks.
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_15N=y

CONFIG_FREERTOS_HZ=100
CONFIG_NEWLIB_NANO_FORMAT=y
